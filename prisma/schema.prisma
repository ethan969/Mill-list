generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A production company — the tenancy root. The platform is multi-tenant:
/// every Project/Slate (and everything hanging off them) belongs to
/// exactly one Company, and admin access is always scoped through a
/// CompanyMembership, never global. See docs/multi-tenancy-plan.md for
/// the full migration this model is part of, and src/lib/tenant-db.ts for
/// how every tenant-model query gets companyId injected automatically.
model Company {
  id        String   @id @default(cuid())
  name      String
  /// Reserved for a future per-company surface (e.g. a subdomain or
  /// portal path); not read anywhere yet.
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMembership[]
  projects    Project[]
  slates      Slate[]
  fxRates     FxRate[]
  auditLogs   AuditLog[]

  // onDelete: Restrict on every relation below (and on CompanyMembership/
  // AuditLog) is deliberate — a Company can't be deleted while it still
  // owns anything. Accidental mass-deletion (a bad script, a careless
  // test helper) has to tear down every child explicitly first.
}

/// A platform login identity — one person, one row, regardless of how
/// many companies they belong to (see CompanyMembership). Was named
/// AdminUser before multi-tenancy; renamed rather than recreated so
/// existing admin_session JWTs (whose `sub` claim is this row's id) and
/// existing 2FA enrollment keep working unchanged across the migration.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  /// AES-256-GCM ciphertext (base64), decrypted with TOTP_ENCRYPTION_KEY —
  /// see src/lib/totp.ts. Set as soon as enrollment starts; totpEnabledAt
  /// is what actually gates whether 2FA is required at login.
  totpSecretEncrypted String?
  /// Null until the user confirms enrollment with a valid code.
  totpEnabledAt       DateTime?
  /// The most recent TOTP time-step successfully consumed, so a code
  /// can't be replayed within its own validity window.
  totpLastUsedStep    Int?

  /// Mill List's own operators, not company staff — lets a platform admin
  /// act on any company without a CompanyMembership row for each one, via
  /// the explicit, audited bypass in src/lib/tenant-context.ts's
  /// resolveCompanyId. Not settable through any admin UI; seeded directly.
  isPlatformAdmin Boolean @default(false)

  recoveryCodes AdminRecoveryCode[]
  memberships   CompanyMembership[]
  auditLogs     AuditLog[]
}

/// Single-use 2FA recovery codes, bcrypt-hashed (never stored in plaintext,
/// so seeing this table doesn't reveal usable codes — see src/lib/totp.ts).
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum CompanyRole {
  OWNER
  EDITOR
}

/// Which Users belong to which Company, and with what role. Many-to-many
/// by design (a person could belong to more than one company) even though
/// the beta only needs one company per user — see
/// src/lib/tenant-context.ts's resolveCompanyId for how this is resolved
/// per request (never cached in the session JWT; always a fresh lookup,
/// same "never trust a cached authorization decision" discipline this
/// codebase already uses for room/slate sessionVersion checks).
model CompanyMembership {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role      CompanyRole
  createdAt DateTime    @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

/// Minimal, narrow-purpose audit trail — not a general-purpose logging
/// system. Added specifically because the platform-admin cross-company
/// bypass (src/lib/tenant-context.ts) needs a trail from the moment it
/// exists, not bolted on after the fact; every other write path is
/// expected to stay within its own company by construction (the composite
/// foreign keys below) rather than needing to be logged to prove it.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "platform_admin_bypass". Free text deliberately, rather than an
  /// enum — this table is expected to grow new action kinds without a
  /// schema migration for each one.
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
}

enum DocumentSection {
  SCRIPT
  CREATIVE_DECK
  FINANCIALS
  PRODUCTION_PLAN
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

enum Currency {
  GBP
  USD
  EUR
}

enum FinanceSourceType {
  EQUITY
  BFI
  TAX_CREDIT
  PRESALE
  GAP
  DEBT
  SOFT_MONEY
  OTHER
}

enum FinanceSourceStatus {
  COMMITTED
  IN_NEGOTIATION
  SOUGHT
}

enum RecoupmentStructure {
  RING_FENCED
  CROSS_COLLATERALISED
}

model Project {
  id                String    @id @default(cuid())
  /// Nullable for now — backfilled by prisma/migrations/.../add_multi_tenancy_backfill,
  /// flipped NOT NULL by a later migration once every admin route is on
  /// the tenant-scoped client (see docs/multi-tenancy-plan.md Migration C).
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Stays globally unique, deliberately not scoped per company — it's the
  /// literal public URL path (/<slug>, no company segment), so two
  /// companies colliding on a slug would collide on a URL.
  slug              String    @unique
  title             String
  productionCompany String
  tagline           String?
  logline           String?
  posterKey         String?
  posterMimeType    String?
  logoKey           String?
  logoMimeType      String?
  themeId           String    @default("midnight-gold")
  accentColor       String?
  fontId            String?
  landingLayout     String    @default("centered")
  roomLayout        String    @default("top-nav")
  passwordHash      String
  /// Bumped whenever the room password changes or an admin explicitly
  /// revokes viewer sessions — every room JWT carries the version it was
  /// issued under (src/lib/auth.ts), so bumping this invalidates every
  /// cookie issued before the bump without needing a session store.
  sessionVersion    Int       @default(1)
  isPublished       Boolean   @default(false)
  aboutContent      String?
  aboutTeam         Json?
  /// Shown on this film's dedicated page within a slate (src/app/slate/
  /// [slug]/[projectSlug]) — free text, e.g. "$2M - $4M". Not used by the
  /// project's own room.
  approximateBudget String?
  /// Same slate-film-page-only use as approximateBudget, e.g. "Spring 2026".
  idealShootWindow  String?
  /// All of currency/grossBudget/equitySought/minimumTicket/financeSources
  /// below are additive finance tracking, independent of the free-text
  /// approximateBudget above — see src/lib/finance.ts for the calculations
  /// and src/app/slate/[slug] for where they're shown. Nullable/empty
  /// until an admin fills in finance details for this film.
  currency          Currency?
  /// Minor units (e.g. pence, cents) — see src/lib/finance.ts for why, and
  /// for the BigInt<->number boundary (always safe for any realistic film
  /// budget; stored as BigInt purely so the database column itself can
  /// never silently overflow the way a 32-bit Int could).
  grossBudget       BigInt?
  equitySought      BigInt?
  /// Optional per spec — a slate's finance panel can show "contact us" in
  /// its place rather than treating an unset minimum as zero.
  minimumTicket     BigInt?
  financeUpdatedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents      Document[]
  gallery        GalleryItem[]
  references     ReferenceLink[]
  downloads      DocumentDownload[]
  slates         SlateProject[]
  financeSources FinanceSource[]

  @@unique([id, companyId]) // composite-FK target for every child below
  @@index([slug])
  @@index([companyId])
}

/// One line item in a film's capital stack — see src/lib/finance.ts for
/// how a Project's FinanceSource rows roll up into totals and a per-status
/// breakdown. All amounts are in that Project's own Project.currency;
/// there's no per-source currency, since a single film's financing is
/// realistically tracked in one currency throughout.
model FinanceSource {
  id                   String              @id @default(cuid())
  projectId            String
  /// Nullable for now — see Project.companyId.
  companyId            String?
  /// Composite FK to Project(id, companyId) — not just (id) — so a row
  /// whose companyId doesn't match its own project's companyId is
  /// physically unrepresentable, not merely unqueried. Same pattern on
  /// every other project/slate-owned model below.
  project              Project?            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  name                 String
  type                 FinanceSourceType
  /// Minor units, same convention as Project.grossBudget.
  amount               BigInt
  status               FinanceSourceStatus
  recoups              Boolean             @default(true)
  /// Lower recoups earlier (1st position, 2nd position, ...) in a ranked
  /// waterfall. Null when this source doesn't participate in one (e.g. it
  /// doesn't recoup at all, or recoups pari passu with everything else at
  /// its tier — this model doesn't represent tiers, only a single ordinal
  /// rank, which is enough for display but not a substitute for the real
  /// legal waterfall in a film's finance documents).
  recoupmentPosition   Int?
  /// Basis points (1% = 100bps), not a float — same reasoning as storing
  /// money in minor units: a premium like "20%" needs to stay exact
  /// through display and any future calculation, which a float percentage
  /// (0.2) can't guarantee bit-for-bit.
  recoupmentPremiumBps Int?
  order                Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([projectId])
  @@index([companyId])
}

/// A curated, password-protected collection of existing Projects, browsable
/// under one shared password. Each member film gets its own simplified page
/// within the slate (src/app/slate/[slug]/[projectSlug] — logline, team,
/// budget, shoot window, one downloadable deck), separate from that
/// project's own full multi-section room. See src/lib/access.ts for how a
/// slate session grants access to a member project's documents (and, if
/// linked to directly, its room) via live membership checks, rather than
/// duplicating each project's own password.
model Slate {
  id                     String               @id @default(cuid())
  /// Nullable for now — see Project.companyId.
  companyId              String?
  company                Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Stays globally unique, same reasoning as Project.slug — the literal
  /// public URL path, no company segment.
  slug                   String               @unique
  title                  String
  /// Short teaser shown even before the password gate is passed (like a
  /// project's tagline). aboutContent below is the longer production-
  /// company intro shown only once inside the slate.
  overview               String?
  /// The slate's own intro/"about us" page, shown once authenticated,
  /// above the film grid — same paragraph-per-blank-line convention as
  /// Project.aboutContent.
  aboutContent           String?
  themeId                String               @default("midnight-gold")
  accentColor            String?
  fontId                 String?
  passwordHash           String
  /// Same draft/live meaning as Project.isPublished: the public
  /// /slate/[slug] page 404s while this is false, even with a valid
  /// password. Defaults to false so a newly created slate isn't reachable
  /// until an admin explicitly publishes it.
  isPublished            Boolean              @default(false)
  /// Same invalidation pattern as Project.sessionVersion — bumped on a
  /// password change or an explicit revoke; every slate JWT carries the
  /// version it was issued under (src/lib/slate-token.ts).
  sessionVersion         Int                  @default(1)
  /// How member films' capital stacks relate to each other financially —
  /// shown as a plain-language statement on the Finance panel alongside
  /// recoupmentNote. Null (and the panel's recoupment statement omitted)
  /// until an admin sets it; this is disclosure copy, not something the
  /// app enforces or calculates from.
  recoupmentStructure    RecoupmentStructure?
  /// Explains recoupmentStructure above in plain language — e.g. which
  /// films are cross-collateralised with which, or why they're ring-fenced.
  recoupmentNote         String?
  disclaimerText         String?
  /// The currency slate-level finance totals (src/lib/finance.ts) are
  /// converted to and shown in. Not in the original spec's field list for
  /// Slate — added because "converted to the slate's display currency" in
  /// the calculations requirement names a field that has to live
  /// somewhere; defaulted to GBP absent any other signal to pick from.
  financeDisplayCurrency Currency             @default(GBP)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  projects  SlateProject[]
  documents Document[]
  downloads DocumentDownload[]

  @@unique([id, companyId]) // composite-FK target for every child below
  @@index([slug])
  @@index([companyId])
}

/// A single exchange rate snapshot, multiplying 1 unit of `from` into
/// `rate` units of `to` — e.g. from: USD, to: GBP, rate: 0.79 means 1 USD
/// = 0.79 GBP. Rows accumulate over time (asOfDate); src/lib/finance.ts
/// always looks up the most recent row for a given (from, to) pair rather
/// than assuming there's only ever one. See that file for why a missing
/// rate is a reported error state, never a guessed/defaulted conversion.
///
/// Per-company, not shared platform-wide — each company's finance team
/// enters and sees only its own rates. A real behavior change from the
/// pre-multi-tenancy version of this table (which had no owner at all):
/// company B no longer benefits from a rate company A already entered for
/// the same currency pair/date.
model FxRate {
  id        String   @id @default(cuid())
  /// Nullable for now — see Project.companyId. FxRate had no owner at all
  /// before this migration, so every existing row starts here too.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  from      Currency
  to        Currency
  /// An exact decimal (backed by Prisma.Decimal / decimal.js →  Postgres
  /// NUMERIC), not a float — this multiplies integer minor-unit money
  /// amounts, and a binary float rate couldn't guarantee that stays exact.
  rate      Decimal  @db.Decimal(18, 8)
  asOfDate  DateTime

  @@index([companyId, from, to, asOfDate])
}

/// Which Projects a Slate currently includes, and in what order to list
/// them — membership is checked live against this table on every request
/// (src/lib/access.ts), not baked into the slate session token, so
/// removing a film from a slate takes effect immediately for anyone
/// already holding a valid slate cookie.
///
/// Carries its own companyId, with a composite FK to *both* Slate and
/// Project on (parentId, companyId). Since this row has only one
/// companyId value, both FKs can only be satisfied simultaneously when
/// slate.companyId === project.companyId — the database makes "a slate
/// including another company's film" unrepresentable, not just unqueried.
model SlateProject {
  id        String   @id @default(cuid())
  slateId   String
  /// Nullable for now — see Project.companyId.
  companyId String?
  slate     Slate?   @relation(fields: [slateId, companyId], references: [id, companyId], onDelete: Cascade)
  projectId String
  project   Project? @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([slateId, projectId])
  @@index([slateId])
  @@index([projectId])
  @@index([companyId])
}

/// A document belongs to exactly one of a Project (its room) or a Slate
/// (a slate-level document, e.g. an overview deck not tied to one film) —
/// enforced by a database CHECK constraint added by this model's migration
/// (Prisma's schema DSL doesn't express arbitrary CHECK constraints, so
/// it's appended as raw SQL there) rather than by application code alone.
///
/// companyId is required (unlike projectId/slateId) and carries composite
/// FKs to both possible parents — Postgres's default MATCH SIMPLE means a
/// composite FK with a null column (projectId or slateId, whichever this
/// row doesn't use) is simply not checked, so the XOR CHECK constraint and
/// these composite FKs compose correctly together.
model Document {
  id         String          @id @default(cuid())
  /// Nullable for now — see Project.companyId.
  companyId  String?
  projectId  String?
  project    Project?        @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  slateId    String?
  slate      Slate?          @relation(fields: [slateId, companyId], references: [id, companyId], onDelete: Cascade)
  section    DocumentSection
  title      String
  fileKey    String
  fileName   String          @default("document.pdf")
  mimeType   String          @default("application/pdf")
  fileSize   Int?
  pageCount  Int?
  pageWidth  Float?
  pageHeight Float?
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  downloads DocumentDownload[]

  @@unique([id, companyId]) // composite-FK target for DocumentDownload.document below
  @@index([projectId, section])
  @@index([slateId, section])
  @@index([companyId])
}

model GalleryItem {
  id        String          @id @default(cuid())
  projectId String
  /// Nullable for now — see Project.companyId.
  companyId String?
  project   Project?        @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  type      GalleryItemType
  fileKey   String
  fileName  String          @default("file")
  mimeType  String          @default("application/octet-stream")
  caption   String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([projectId])
  @@index([companyId])
}

model ReferenceLink {
  id        String   @id @default(cuid())
  projectId String
  /// Nullable for now — see Project.companyId.
  companyId String?
  project   Project? @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([companyId])
}

/// Recorded each time someone provides their email to receive a
/// watermarked copy of a document from the data room by email. projectId
/// is nullable (unlike before) because a slate-level document has no
/// project to record — but projectId and slateId are NOT mutually
/// exclusive the way they are on Document: downloading a project-owned
/// document via a slate session records both (which project's document,
/// and which slate the access came through), while downloading a
/// slate-level document records only slateId.
///
/// This is the closest thing to a "viewer"/"investor list" entity in the
/// app today — there is no separate Viewer/Lead model (see
/// docs/multi-tenancy-plan.md). No uniqueness constraint exists on email
/// here, and none is added by this migration; if a real Viewer identity
/// is ever built, its uniqueness must be scoped @@unique([companyId,
/// email]), never global — the same person can legitimately be a
/// prospective investor for two unrelated companies on this platform.
model DocumentDownload {
  id         String    @id @default(cuid())
  /// Nullable for now — see Project.companyId.
  companyId  String?
  projectId  String?
  project    Project?  @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  slateId    String?
  slate      Slate?    @relation(fields: [slateId, companyId], references: [id, companyId], onDelete: Cascade)
  documentId String
  document   Document? @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Cascade)
  email      String
  emailSent  Boolean   @default(false)
  linkOpened Boolean   @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([slateId])
  @@index([email])
  @@index([companyId])
}

/// Backs the per-key rate limiter (src/lib/rate-limit.ts) — a fixed window
/// per key (e.g. "admin-login:<ip>", "room:<slug>:<ip>"), stored in
/// Postgres instead of in-memory so it actually holds across Vercel's
/// separate serverless instances. An expired row is simply treated as a
/// fresh window on its next read (checkRateLimit), and is also deleted on
/// a successful auth (clearAttempts). checkRateLimit additionally sweeps
/// every already-expired row with small probability on each call
/// (sweepExpiredAttempts) so the table doesn't grow unboundedly from keys
/// that are never explicitly cleared — no separate cron job/route needed.
///
/// Deliberately NOT company-scoped — see docs/multi-tenancy-plan.md §1.
/// Its key is a free-form string with no real FK, and its purpose (abuse
/// prevention) would be defeated by letting an attacker reset their
/// budget by "switching companies."
model RateLimitAttempt {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
