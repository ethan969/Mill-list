generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  /// AES-256-GCM ciphertext (base64), decrypted with TOTP_ENCRYPTION_KEY —
  /// see src/lib/totp.ts. Set as soon as enrollment starts; totpEnabledAt
  /// is what actually gates whether 2FA is required at login.
  totpSecretEncrypted String?
  /// Null until the admin confirms enrollment with a valid code.
  totpEnabledAt        DateTime?
  /// The most recent TOTP time-step successfully consumed, so a code
  /// can't be replayed within its own validity window.
  totpLastUsedStep     Int?

  recoveryCodes AdminRecoveryCode[]
}

/// Single-use 2FA recovery codes, bcrypt-hashed (never stored in plaintext,
/// so seeing this table doesn't reveal usable codes — see src/lib/totp.ts).
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

enum DocumentSection {
  SCRIPT
  CREATIVE_DECK
  FINANCIALS
  PRODUCTION_PLAN
}

enum GalleryItemType {
  IMAGE
  VIDEO
}

model Project {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  productionCompany String
  tagline           String?
  logline           String?
  posterKey         String?
  posterMimeType    String?
  logoKey           String?
  logoMimeType      String?
  themeId           String   @default("midnight-gold")
  accentColor       String?
  fontId            String?
  landingLayout     String   @default("centered")
  roomLayout        String   @default("top-nav")
  passwordHash      String
  isPublished       Boolean  @default(false)
  aboutContent      String?
  aboutTeam         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents  Document[]
  gallery    GalleryItem[]
  references ReferenceLink[]
  downloads  DocumentDownload[]

  @@index([slug])
}

model Document {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   DocumentSection
  title     String
  fileKey   String
  fileName  String          @default("document.pdf")
  mimeType  String          @default("application/pdf")
  fileSize  Int?
  pageCount Int?
  pageWidth  Float?
  pageHeight Float?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  downloads DocumentDownload[]

  @@index([projectId, section])
}

model GalleryItem {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      GalleryItemType
  fileKey   String
  fileName  String          @default("file")
  mimeType  String          @default("application/octet-stream")
  caption   String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([projectId])
}

model ReferenceLink {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Recorded each time someone provides their email to receive a
/// watermarked copy of a document from the data room by email.
model DocumentDownload {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  email      String
  emailSent  Boolean  @default(false)
  linkOpened Boolean  @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([email])
}

/// Backs the per-key rate limiter (src/lib/rate-limit.ts) — a fixed window
/// per key (e.g. "admin-login:<ip>", "room:<slug>:<ip>"), stored in
/// Postgres instead of in-memory so it actually holds across Vercel's
/// separate serverless instances. Rows aren't proactively swept once
/// expired (only deleted on a successful auth, via clearAttempts); an
/// expired row is simply treated as a fresh window on its next read.
model RateLimitAttempt {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
