DATABASE_URL="postgresql://user:password@localhost:5432/mill_list"

# Session signing secret. Generate a strong random value, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=""

# Encrypts each admin's TOTP secret at rest (AES-256-GCM). Must decode from
# base64 to exactly 32 bytes — generate with:
#   openssl rand -base64 32
# Losing/rotating this locks out everyone already enrolled in 2FA (their
# stored secret becomes undecryptable) — back it up somewhere safe.
TOTP_ENCRYPTION_KEY=""

# Initial admin account (used by `npm run seed:admin`). Change the password
# immediately after first login — this only seeds/updates the one account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
# Leave STORAGE_* unset to fall back to local disk storage under ./storage.
# That's fine for local development but is NOT durable in most production
# hosting (e.g. serverless platforms wipe local disk between deploys) — set
# these before going live.
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="mill-list-assets"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_FORCE_PATH_STYLE="true"

# Shown on the neutral "/" page (not a specific film's data room).
SITE_NAME="Your Production Company"

# Email delivery for watermarked downloads (https://resend.com). Requires a
# verified sending domain in production. Leave RESEND_API_KEY unset to run
# in dev-fallback mode, where the download link is logged to the server
# console instead of emailed — nothing crashes, but nothing gets sent either.
# RESEND_API_KEY=""
# EMAIL_FROM="Your Production Company <dataroom@yourdomain.com>"

# Base URL used to build the links emailed to visitors (e.g.
# "https://yourdomain.com"). Falls back to the request's own origin if
# unset — only needed if you're behind a proxy that changes the host/scheme
# seen by the app.
# APP_URL=""
