DATABASE_URL="postgresql://user:password@localhost:5432/mill_list"

# Session signing secret. Generate a strong random value, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=""

# Initial admin account (used by `npm run seed:admin`). Change the password
# immediately after first login — this only seeds/updates the one account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
# Leave STORAGE_* unset to fall back to local disk storage under ./storage.
# That's fine for local development but is NOT durable in most production
# hosting (e.g. serverless platforms wipe local disk between deploys) — set
# these before going live.
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_BUCKET="mill-list-assets"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_FORCE_PATH_STYLE="true"

# Shown on the neutral "/" page (not a specific film's data room).
SITE_NAME="Your Production Company"
